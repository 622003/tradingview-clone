# Required: Prisma database connection string.
# Default: local SQLite file. Swap to a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# Required: cookie/session signing secret.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

# Optional. Public URL of the deployed app (used in share links if you add them).
APP_URL="http://localhost:3000"
