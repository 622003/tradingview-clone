# ──────────────────────────────────────────────────────────────────────────────
# Database (required)
# ──────────────────────────────────────────────────────────────────────────────
# Local dev defaults to SQLite. For production, point at Postgres and switch
# `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"
# Example Postgres value:
# DATABASE_URL="postgresql://tradeview:password@localhost:5432/tradeview?schema=public"

# ──────────────────────────────────────────────────────────────────────────────
# Two-site hosting (required for the user/admin split)
# ──────────────────────────────────────────────────────────────────────────────
# Defaults use `lvh.me` — a public DNS service that resolves *.lvh.me to
# 127.0.0.1 — so you can run both hosts locally with no /etc/hosts edits.
#
# Visit:   http://app.lvh.me:3000   for the user site
# Visit:   http://admin.lvh.me:3000 for the admin site
USER_HOST="app.lvh.me:3000"
ADMIN_HOST="admin.lvh.me:3000"

# Parent domain for the session cookie. Must be a suffix shared by both hosts
# so a single sign-in covers both sites. Leave EMPTY for single-host deploys
# that don't need cross-host SSO.
COOKIE_DOMAIN=".lvh.me"

# ──────────────────────────────────────────────────────────────────────────────
# Auth (optional)
# ──────────────────────────────────────────────────────────────────────────────
# Reserved for future cookie/JWT signing. The current session implementation
# uses random opaque tokens stored in the database, so no signing key is
# required yet — but keep this set so future migrations don't break.
# Generate with:  openssl rand -hex 32
SESSION_SECRET="change-me-generate-with-openssl-rand-hex-32"

# ──────────────────────────────────────────────────────────────────────────────
# Misc (optional)
# ──────────────────────────────────────────────────────────────────────────────
# Public URL of the user site. Used in share links if you add them later.
APP_URL="http://app.lvh.me:3000"
